/* ============================================
   R2 NUSANTARA - MAIN STYLESHEET
   Base Styles, Variables & Utilities
   ============================================ */

:root {
  --transition-smooth: cubic-bezier(0.16, 1, 0.3, 1);
  --color-brand-900: #060d18;
  --color-brand-800: #0a1628;
  --color-brand-700: #162544;
  --color-brand-600: #1e3a5f;
  --color-brand-500: #2563eb;
  --color-brand-400: #3b82f6;
  --color-brand-300: #60a5fa;
  --color-brand-200: #93c5fd;
  --color-brand-100: #dbeafe;
  --color-brand-50: #eff6ff;
}

/* Base Styles */
body {
  background-color: #f8f9fc;
  font-feature-settings: 'cv02', 'cv03', 'cv04', 'cv11';
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

button, a, select {
  touch-action: manipulation;
}

/* Scrollbar Custom */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: #c8cdd6;
  border-radius: 10px;
  border: 2px solid #f8f9fc;
}

::-webkit-scrollbar-thumb:hover {
  background: #3b82f6;
}

::selection {
  background: rgba(37, 99, 235, 0.2);
  color: #0a1628;
}

/* Hardware Acceleration */
.animate-blob,
.card-premium,
.hero-overlay,
.modal-hardware {
  will-change: transform, opacity;
  transform: translateZ(0);
}

/* Glass Effects */
.glass-pill {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(24px) saturate(200%);
  -webkit-backdrop-filter: blur(24px) saturate(200%);
  border: 1px solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 4px 24px-4px rgba(10, 22, 40, 0.06),
              0 2px 8px-2px rgba(10, 22, 40, 0.04),
              inset 0 0 0 1px rgba(255, 255, 255, 0.5);
}

.glass-dark {
  background: rgba(10, 22, 40, 0.7);
  backdrop-filter: blur(24px) saturate(180%);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

/* Premium Animated Brand Header */
.premium-text-gradient {
  background: linear-gradient(110deg, #0a1628 0%, #a0aec0 40%, #d4af37 60%, #0a1628 100%);
  background-size: 200% auto;
  color: transparent;
  -webkit-background-clip: text;
  background-clip: text;
  animation: textShimmer 4s linear infinite;
  text-shadow: 0 2px 10px rgba(212, 175, 55, 0.15);
}

@keyframes textShimmer {
  to { background-position: 200% center; }
}

.verified-badge {
  filter: drop-shadow(0 0 3px rgba(59, 130, 246, 0.4));
  animation: verifiedPulse 3s infinite ease-in-out;
}

@keyframes verifiedPulse {
  0%, 100% {
    filter: drop-shadow(0 0 2px rgba(59, 130, 246, 0.3)) scale(1);
  }
  50% {
    filter: drop-shadow(0 0 6px rgba(59, 130, 246, 0.8)) scale(1.05);
  }
}

/* Realistic Smoke Effect */
.smoke-wrapper {
  position: absolute;
  inset: -50% -20%;
  pointer-events: none;
  overflow: hidden;
  z-index: -1;
  opacity: 0.3;
  transition: opacity 0.35s ease;
  -webkit-mask-image: radial-gradient(circle at center, black 20%, transparent 70%);
  mask-image: radial-gradient(circle at center, black 20%, transparent 70%);
}

.group:hover .smoke-wrapper {
  opacity: 0.8;
}

.smoke-particle {
  position: absolute;
  bottom: 10px;
  width: 12px;
  height: 12px;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  filter: blur(8px);
  opacity: 0;
  animation: smokeRise var(--dur, 4s) infinite cubic-bezier(0.25, 0.46, 0.45, 0.94);
  will-change: transform, opacity;
}

.sp-1 { left: 10%; --dur: 4.5s; animation-delay: 0s; }
.sp-2 { left: 40%; --dur: 3.8s; animation-delay: 1.2s; }
.sp-3 { left: 70%; --dur: 4.2s; animation-delay: 2.5s; }
.sp-4 { left: 85%; --dur: 5s; animation-delay: 0.8s; }

@keyframes smokeRise {
  0% {
    transform: translateY(0) scale(1) translateX(0);
    opacity: 0;
  }
  30% { opacity: 0.5; }
  70% { opacity: 0.2; }
  100% {
    transform: translateY(-35px) scale(3.5) translateX(15px);
    opacity: 0;
  }
}

.brand-hover-transition {
  transition: all 0.35s ease;
}

/* Hero Overlays */
.hero-overlay {
  background: linear-gradient(180deg,
    rgba(6, 13, 24, 0.92) 0%,
    rgba(10, 22, 40, 0.6) 40%,
    rgba(10, 22, 40, 0.9) 80%,
    #f8f9fc 100%),
    radial-gradient(circle at top right, rgba(37, 99, 235, 0.15) 0%, transparent 50%),
    radial-gradient(circle at bottom left, rgba(37, 99, 235, 0.15) 0%, transparent 50%);
}

.grid-pattern {
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
  background-size: 64px 64px;
}

.card-premium {
  transition: all 0.5s var(--transition-smooth);
}

.card-premium:hover {
  transform: translateY(-8px) translateZ(0);
  box-shadow: 0 32px 64px-12px rgba(10, 22, 40, 0.1),
              0 16px 24px-8px rgba(10, 22, 40, 0.06);
}

.card-glow:hover::before {
  opacity: 1;
}

.card-glow::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(800px circle at var(--mouse-x) var(--mouse-y),
    rgba(59, 130, 246, 0.08), transparent 40%);
  opacity: 0;
  transition: opacity 0.5s;
  pointer-events: none;
  z-index: 1;
}

/* Ticker */
.ticker-wrap {
  width: 100%;
  overflow: hidden;
  background: linear-gradient(90deg,
    transparent,
    rgba(37, 99, 235, 0.05) 20%,
    rgba(37, 99, 235, 0.05) 80%,
    transparent);
}

.ticker-mask {
  -webkit-mask-image: linear-gradient(90deg,
    transparent, black 10%, black 90%, transparent);
  mask-image: linear-gradient(90deg,
    transparent, black 10%, black 90%, transparent);
}

/* Fade on Scroll */
.fade-on-scroll {
  opacity: 0;
  transform: translateY(40px) translateZ(0);
  transition: opacity 0.9s var(--transition-smooth),
              transform 0.9s var(--transition-smooth);
}

.fade-on-scroll.is-visible {
  opacity: 1;
  transform: translateY(0) translateZ(0);
}

.text-gradient {
  background: linear-gradient(135deg, #ffffff 0%, #93c5fd 50%, #ffffff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.no-scrollbar::-webkit-scrollbar {
  display: none;
}

.no-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

/* Button Glow */
.btn-glow {
  position: relative;
}

.btn-glow::after {
  content: '';
  position: absolute;
  inset: -4px;
  background: linear-gradient(90deg, #3b82f6, #60a5fa, #3b82f6);
  filter: blur(12px);
  opacity: 0;
  transition: opacity 0.4s ease;
  z-index: -1;
  border-radius: inherit;
}

.btn-glow:hover::after {
  opacity: 0.6;
}

/* Ripple Effect */
.ripple {
  position: relative;
  overflow: hidden;
}

.ripple::after {
  content: "";
  display: block;
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  pointer-events: none;
  background-image: radial-gradient(circle, rgba(255, 255, 255, 0.4) 10%, transparent 10.01%);
  background-repeat: no-repeat;
  background-position: 50%;
  transform: scale(10, 10);
  opacity: 0;
  transition: transform .5s, opacity 1s;
}

.ripple:active::after {
  transform: scale(0, 0);
  opacity: .3;
  transition: 0s;
}

.stepper-enter {
  animation: stepperPop 0.4s var(--transition-smooth);
}

@keyframes stepperPop {
  0% {
    transform: scale(0.85);
    opacity: 0;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

/* Avatar Premium */
.avatar-initial {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: white;
  font-weight: 800;
  letter-spacing: -0.02em;
  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
  font-size: 1.5rem;
  border: 2px solid rgba(255, 255, 255, 0.2);
  box-shadow: inset 0 2px 4px rgba(255, 255, 255, 0.4),
              0 8px 16px-4px rgba(10, 22, 40, 0.15);
}

.avatar-gradient-1 { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
.avatar-gradient-2 { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); }
.avatar-gradient-3 { background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); }
.avatar-gradient-4 { background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); }
.avatar-gradient-5 { background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); }
.avatar-gradient-9 { background: linear-gradient(135deg, #2563eb 0%, #1e3a5f 100%); }

/* Back to Top */
.back-to-top {
  position: fixed;
  bottom: 24px;
  right: 24px;
  width: 48px;
  height: 48px;
  background: white;
  border: 1px solid #e2e6ed;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0a1628;
  box-shadow: 0 8px 24px rgba(10, 22, 40, 0.08);
  cursor: pointer;
  z-index: 50;
  opacity: 0;
  transform: translateY(20px);
  transition: all 0.4s var(--transition-smooth);
  pointer-events: none;
}

.back-to-top.visible {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.back-to-top:hover {
  background: #0a1628;
  color: white;
  transform: translateY(-4px);
  box-shadow: 0 12px 32px rgba(10, 22, 40, 0.2);
}
