{
  "name": "r2-nusantara",
  "version": "1.0.0",
  "description": "Gudang Distributor Malang - Professional E-commerce Platform",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "dev": "http-server -p 8000 --cors",
    "build": "npm run lint && npm run format:check",
    "serve": "http-server -p 3000",
    "lint": "eslint 'js/**/*.js' --max-warnings 0",
    "lint:fix": "eslint 'js/**/*.js' --fix",
    "format": "prettier --write \"**/*.{js,html,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,html,css,md}\"",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "audit": "npm audit --audit-level=moderate",
    "clean": "rm -rf node_modules dist coverage"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.0",
    "bootstrap": "^5.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.0.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0",
    "http-server": "^14.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gudangdistributormalang-r2nusantara/R2-Nusantara.git"
  },
  "keywords": [
    "e-commerce",
    "distributor",
    "malang",
    "pwa",
    "responsive"
  ],
  "author": "Gudang Distributor Malang",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
